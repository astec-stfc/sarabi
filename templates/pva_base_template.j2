        {% if config.dtype == "statistical" or config.dtype == "scalar" or config.dtype == "float" or config.dtype=="int"%}
        self.{{name}} = SharedPV(nt=NTScalar("d"), handler=Handler(), initial={{ dtype_map[config.dtype].initial if config.dtype is defined else '0.0' }})
        {% elif config.dtype == "state" %}
        self.{{name}} = SharedPV(nt=NTEnum(),
            handler=EnumHandler(),
