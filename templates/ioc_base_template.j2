import sys

from caproto.server import pvproperty, ioc_arg_parser, run
from caproto import ChannelType, SkipWrite
import numpy as np

# First, so that another package called "core" is not found in place of SARABI's
sys.path.insert(0, r"{{ sarabi_root }}")
from core.device.base_server import CASimulatedPVGroup


class {{class_name}}(CASimulatedPVGroup):
{% if pv_map or unique_pv_map %}
    {% for name, config in pv_map.items() %}
        {{ name }}: pvproperty = pvproperty(
            value={{ dtype_map[kinds[name]].initial }},
            dtype={{ dtype_map[kinds[name]].dtype }},
            {% if dtype_map[kinds[name]].max_length is defined %}max_length={{ dtype_map[kinds[name]].max_length }},
            {% endif %}
            {% if kinds[name] == "state" %}
            enum_strings=[
                {% for key, _ in config.states|dictsort(by='value') %}
                {{ key|pystr }}{% if not loop.last %}, {% endif %}
                {% endfor %}
            ],
            {% endif %}
            {% if config.units is defined and dtype_map[kinds[name]].units %}units={{ config.units|pystr }},{% endif %}
            doc={{ (config.description if config.description is defined else 'default description.')|pystr }},
        )
    {% endfor %}
    # The following PVs may not exist for all IOCs of this type.
    {% for name, config in unique_pv_map.items() %}
        {{ name }}: pvproperty | None = pvproperty(
            value={{ dtype_map[kinds[name]].initial }},
            {% if dtype_map[kinds[name]].max_length is defined %}max_length={{ dtype_map[kinds[name]].max_length }},
            {% endif %}
            dtype={{ dtype_map[kinds[name]].dtype }},
            {% if kinds[name] == "state" %}
            enum_strings=[
                {% for key, _ in config.states|dictsort(by='value') %}
                {{ key|pystr }}{% if not loop.last %}, {% endif %}
                {% endfor %}
            ],
            {% endif %}
            {% if config.units is defined and dtype_map[kinds[name]].units %}units={{ config.units|pystr }},{% endif %}
            doc={{ (config.description if config.description is defined else 'default description.')|pystr }},
        )
    {% endfor %}
    # Setpoint/readback pairs and update signals differ per device, so they are
    # supplied at construction and advanced by the group. Every PV asks the group
    # to start; only the first call drives it, the rest return immediately. That
    # includes the PVs only some devices have, which may be all a device has.
    {% for name, config in pv_map.items()|list + unique_pv_map.items()|list %}
        @{{ name }}.startup
        async def {{ name }}(self, instance, async_lib):
            await self.drive(async_lib)

        {% if kinds[name] == "state" %}
        @{{ name }}.putter
        async def {{ name }}(self, instance, value):
            if isinstance(value, str):
                if value in instance.enum_strings:
                    return value
                else:
                    raise SkipWrite(f"Invalid state string: {value}")
            elif isinstance(value, int):
                if 0 <= value < len(instance.enum_strings):
                    return value
                else:
                    raise SkipWrite(f"Invalid state index: {value}")
            else:
                raise TypeError("Could not write value to channel.")
        {% endif %}
    {% endfor %}

{% else %}
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
{% endif %}

if __name__ == '__main__':
    ioc_options, run_options = ioc_arg_parser(
        default_prefix='',
        desc='Simulated EPICS records IOC'
    )
    ioc = {{class_name}}(**ioc_options)
    print(ioc.pvdb)
    run(ioc.pvdb, **run_options)