class {{class_name}}(CASimulatedPVGroup):
{% if pv_map %}
    {% for name, config in pv_map.items() %}
        {{ name }}: pvproperty = pvproperty(
            value={{ dtype_map[config.type].initial if config.type is defined else '0.0' }},
            dtype={{ dtype_map[config.type].dtype if config.type is defined else 'ChannelType.FLOAT' }},
            {% if config.type is defined and dtype_map[config.type].max_length is defined %}max_length={{ dtype_map[config.type].max_length }},
            {% endif %}
            {% if config.type is defined and config.type == "state" %}
            enum_strings=[
                {% for key, _ in config.states|dictsort(by='value') %}
                "{{ key }}"{% if not loop.last %}, {% endif %}
                {% endfor %}
            ],
            {% endif %}
            {% if config.units is defined %}units="{{ config.units }}",{% endif %}
            doc="{{ config.description if config.description is defined else 'default description.' }}",
        )
    {% endfor %}
    # The following PVs may not exist for all IOCs of this type.
    {% for name, config in unique_pv_map.items() %}
        {{ name }}: pvproperty | None = pvproperty(
            value={{ dtype_map[config.type].initial if config.type is defined else '0.0' }},
            {% if config.type is defined and dtype_map[config.type].max_length is defined %}max_length={{ dtype_map[config.type].max_length }},
            {% endif %}
            dtype={{ dtype_map[config.type].dtype if config.type is defined else 'ChannelType.FLOAT' }},
            {% if config.type is defined and config.type == "state" %}
            enum_strings=[
                {% for key, _ in config.states|dictsort(by='value') %}
                "{{ key }}"{% if not loop.last %}, {% endif %}
                {% endfor %}
            ],
            {% endif %}
            {% if config.units is defined %}units="{{ config.units }}",{% endif %}
            doc="{{ config.description if config.description is defined else 'default description.' }}",
        )
    {% endfor %}
    # Setpoint/readback pairs and update signals differ per device, so they are
    # supplied at construction and advanced by the group. Every PV asks the group
    # to start; only the first call drives it, the rest return immediately.
    {% for name, config in pv_map.items() %}
        @{{ name }}.startup
        async def {{ name }}(self, instance, async_lib):
            await self.drive(async_lib)

        {% if config.type is defined and config.type == "state"%}
        @{{ name }}.putter
        async def {{ name }}(self, instance, value):
            if isinstance(value, str):
                if value in instance.enum_strings:
                    return value
                else:
                    raise SkipWrite(f"Invalid state string: {value}")
            elif isinstance(value, int):
                if 0 <= value < len(instance.enum_strings):
                    return value
                else:
                    raise SkipWrite(f"Invalid state index: {value}")
            else:
                raise TypeError("Could not write value to channel.")
        {% endif %}
    {% endfor %}

{% else %}
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
{% endif %}

